---
import '@fontsource-variable/inter';
import SEO from '~/components/layout/SEO.astro';
import SiteFooter from '~/components/layout/SiteFooter.astro';
import SiteHeader from '~/components/layout/SiteHeader.astro';
import SiteRibbon from '~/components/layout/SiteRibbon.astro';
import { SolidQueryDevtools } from '~/components/SolidQueryDevtools.tsx';
import { FATHOM_SITE_ID } from 'astro:env/client';
import '../styles.css';

const defaults = {
	name: 'Astro Shop',
	description: 'Ready yourself for liftoff and gear up with the latest in Astro swag.',
	image: {
		src: new URL('/social-v2.jpg?v=1', Astro.site).href,
		alt: 'Astro Shop',
	},
} as const;

type Props = {
	title: string;
};

const { title } = Astro.props;
---

<html lang="en" class="overflow-x-clip bg-white text-theme-base-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="mask-icon" href="/favicon.svg" color="#8D46E7" />

		<SEO {...defaults} {title} />

		<!-- Website tracking -->
		<script is:inline>
			window.AisensyConfig = { baseUrl: 'https://backend.aisensy.com' };
			!function(a,i,s,e){a.Aisensy=a.Aisensy||{q:[],init:function(){this.q.push(['init'].concat([].slice.call(arguments)))},track:function(){this.q.push(['track'].concat([].slice.call(arguments)))}};
			var d=i.createElement(s);d.async=1;d.src=e;var f=i.getElementsByTagName(s)[0];f.parentNode.insertBefore(d,f);
			}(window,document,'script','https://d1fviw7lxswn81.cloudfront.net/system/aisensy.min.js');
			Aisensy.init('SIG-BpkEJVKA0J');
		</script>

		<!-- Website tracking -->
		<script is:inline>
			window.AisensyConfig = { baseUrl: 'https://backend.aisensy.com/stg' };
			!function(a,i,s,e){a.Aisensy=a.Aisensy||{q:[],init:function(){this.q.push(['init'].concat([].slice.call(arguments)))},track:function(){this.q.push(['track'].concat([].slice.call(arguments)))}};
			var d=i.createElement(s);d.async=1;d.src=e;var f=i.getElementsByTagName(s)[0];f.parentNode.insertBefore(d,f);
			}(window,document,'script','https://d1fviw7lxswn81.cloudfront.net/system/aisensy.min.js');
			Aisensy.init('SIG-00X24l8PqW');
		</script>

		{
			FATHOM_SITE_ID && (
				<script
					src="https://cdn.usefathom.com/script.js"
					data-site={FATHOM_SITE_ID}
					is:inline
					defer
				/>
			)
		}
	</head>
	<body class="content-grid min-h-screen">
		<SiteRibbon />
		<div class={`breakout border-b w-full border-theme-base-300`}></div>
		<SiteHeader />
		<div class={`breakout border-b w-full border-theme-base-300`}></div>
		<slot />
		<div class="pt-48">
			<SiteFooter />
		</div>
		{import.meta.env.DEV && <SolidQueryDevtools client:idle />}
	</body>
</html>
